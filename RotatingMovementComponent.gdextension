[configuration]
    ; By setting entry_symbol = "RotatingMovementComponent_init", you are telling Godot: "When you load this library, look for a C function named RotatingMovementComponent_init to start everything up."
    entry_symbol = "RotatingMovementComponent_init"
    compatibility_minimum = "4.1"

[libraries]
    windows.debug.x86_64 = "res://bin/RotatingMovementComponent.windows.template_debug.dll"
    windows.release.x86_64 = "res://bin/RotatingMovementComponent.windows.template_release.dll"
    linux.debug.x86_64 = "res://bin/RotatingMovementComponent.linux.template_debug.so"
    linux.release.x86_64 = "res://bin/RotatingMovementComponent.linux.template_release.so"
    macos.debug = ""
    macos.release = ""